<Defs>

  <!-- Lightweight Pistol -->
  <ThingDef ParentName="BaseHumanMakeableGun" Name="VWE_Gun_AutomaticPistol_Base">
    <defName>VWE_Gun_AutomaticPistol</defName>
    <label>lightweight pistol</label>
    <description>A highly modified, fully automatic variant of the autopistol, designed to deliver maximum short-range firepower in a compact package. Due to light weight, it is very quick to draw.</description>
    <graphicData>
      <texPath>Things/WeaponRanged/AutomaticPistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Autopistol</soundInteract>
    <recipeMaker>
      <researchPrerequisite>VWE_Quickdraw</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <!-- TODO: fill up -->
    <weaponTags>
      <li>IndustrialGunAdvanced</li>
    </weaponTags>
    <weaponClasses>
    </weaponClasses>
    <statBases>
      <WorkToMake>6800</WorkToMake>
      <Mass>1</Mass>
      <AccuracyTouch>0.7</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.3</AccuracyMedium>
      <AccuracyLong>0.25</AccuracyLong>
      <RangedWeapon_Cooldown>1.233333</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <Plasteel>5</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Autopistol</defaultProjectile>
        <warmupTime>0.166666</warmupTime>
        <range>23.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>Shot_Autopistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <armorPenetration>0.13</armorPenetration>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <armorPenetration>0.13</armorPenetration>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

